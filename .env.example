# URL of the FastAPI backend (server-side only, never exposed to the browser).
# The browser calls /api/* on this app and Next.js forwards it here.
API_URL=http://localhost:8000

# Name of the session cookie the backend sets after Google login.
SESSION_COOKIE_NAME=autopost_session

# Development only: browse the UI without logging in (no backend auth needed).
# Must be false (or absent) in production.
AUTH_BYPASS=false
